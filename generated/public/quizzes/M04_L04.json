{
  "lessonCode": "M04_L04",
  "quizVersion": "phase01-source-2026-07-27",
  "questions": [
    {
      "id": "M04_L04_Q01",
      "questionText": "Что лучше всего описывает конструктивную проблему high-rise building (высотного здания)?",
      "options": [
        {
          "id": "M04_L04_Q01_OPT_A",
          "text": "Оно должно нести только gravity load вниз."
        },
        {
          "id": "M04_L04_Q01_OPT_B",
          "text": "Оно должно нести gravity loads и сопротивляться lateral loads, например ветру."
        },
        {
          "id": "M04_L04_Q01_OPT_C",
          "text": "Ему нужен только красивый фасад."
        },
        {
          "id": "M04_L04_Q01_OPT_D",
          "text": "Ему не нужен foundation."
        }
      ]
    },
    {
      "id": "M04_L04_Q02",
      "questionText": "Что такое structural core (конструктивное ядро)?",
      "options": [
        {
          "id": "M04_L04_Q02_OPT_A",
          "text": "Только декоративный центр плана."
        },
        {
          "id": "M04_L04_Q02_OPT_B",
          "text": "Зона, где могут быть лестницы, лифты, сервисы и элементы сопротивления нагрузкам."
        },
        {
          "id": "M04_L04_Q02_OPT_C",
          "text": "Тип окна."
        },
        {
          "id": "M04_L04_Q02_OPT_D",
          "text": "Рисунок фасада."
        }
      ]
    },
    {
      "id": "M04_L04_Q03",
      "questionText": "Чему помогает сопротивляться bracing (связи / раскосы)?",
      "options": [
        {
          "id": "M04_L04_Q03_OPT_A",
          "text": "Боковому движению и lateral load."
        },
        {
          "id": "M04_L04_Q03_OPT_B",
          "text": "Расстановке мебели."
        },
        {
          "id": "M04_L04_Q03_OPT_C",
          "text": "Изменению цвета краски."
        },
        {
          "id": "M04_L04_Q03_OPT_D",
          "text": "Бликам от окон."
        }
      ]
    },
    {
      "id": "M04_L04_Q04",
      "questionText": "Что такое sway (раскачивание / боковое отклонение)?",
      "options": [
        {
          "id": "M04_L04_Q04_OPT_A",
          "text": "Боковое движение здания под действием сил, например ветра."
        },
        {
          "id": "M04_L04_Q04_OPT_B",
          "text": "Вес мебели."
        },
        {
          "id": "M04_L04_Q04_OPT_C",
          "text": "Тип фундамента."
        },
        {
          "id": "M04_L04_Q04_OPT_D",
          "text": "Материал крыши."
        }
      ]
    },
    {
      "id": "M04_L04_Q05",
      "questionText": "Какой реальный trade-off может возникнуть при увеличении tower stiffness?",
      "options": [
        {
          "id": "M04_L04_Q05_OPT_A",
          "text": "Могут понадобиться больший core, bracing, outriggers, больше cost или меньше свободы плана/фасада."
        },
        {
          "id": "M04_L04_Q05_OPT_B",
          "text": "Lateral loads полностью исчезают."
        },
        {
          "id": "M04_L04_Q05_OPT_C",
          "text": "Floor plates перестают нести нагрузку."
        },
        {
          "id": "M04_L04_Q05_OPT_D",
          "text": "Vertical support больше не нужен."
        }
      ]
    }
  ]
}
