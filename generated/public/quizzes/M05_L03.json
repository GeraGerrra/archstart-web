  "questions": [
    {
      "id": "M05_L03_Q01",
      "questionText": "Что такое building envelope (оболочка здания)?",
      "options": [
        {
          "id": "M05_L03_Q01_OPT_A",
          "text": "Только декоративная поверхность фасада."
        },
        {
          "id": "M05_L03_Q01_OPT_B",
          "text": "Граничная система, которая отделяет внешнюю погоду от внутреннего комфорта."
        },
        {
          "id": "M05_L03_Q01_OPT_C",
          "text": "Только конструктивный каркас."
        },
        {
          "id": "M05_L03_Q01_OPT_D",
          "text": "Только внутренняя отделка."
        }
      ]
    },
    {
      "id": "M05_L03_Q02",
      "questionText": "Почему слабо рисовать стену как одну толстую линию?",
      "options": [
        {
          "id": "M05_L03_Q02_OPT_A",
          "text": "Такой рисунок всегда запрещён."
        },
        {
          "id": "M05_L03_Q02_OPT_B",
          "text": "Он скрывает роли слоёв: insulation, waterproofing, air control, structure и finish."
        },
        {
          "id": "M05_L03_Q02_OPT_C",
          "text": "Он делает чертёж слишком красивым."
        },
        {
          "id": "M05_L03_Q02_OPT_D",
          "text": "Он означает, что у стены нет материала."
        }
      ]
    },
    {
      "id": "M05_L03_Q03",
      "questionText": "Какой слой в основном замедляет теплопередачу через стену?",
      "options": [
        {
          "id": "M05_L03_Q03_OPT_A",
          "text": "Insulation (теплоизоляция)."
        },
        {
          "id": "M05_L03_Q03_OPT_B",
          "text": "Интерьерный постер."
        },
        {
          "id": "M05_L03_Q03_OPT_C",
          "text": "Дверная ручка."
        },
        {
          "id": "M05_L03_Q03_OPT_D",
          "text": "Мебель."
        }
      ]
    },
    {
      "id": "M05_L03_Q04",
      "questionText": "Что такое thermal bridge (тепловой мост)?",
      "options": [
        {
          "id": "M05_L03_Q04_OPT_A",
          "text": "Декоративный мост между зданиями."
        },
        {
          "id": "M05_L03_Q04_OPT_B",
          "text": "Путь, где тепло проходит через envelope легче, часто из-за разрыва insulation."
        },
        {
          "id": "M05_L03_Q04_OPT_C",
          "text": "Тип оконной шторы."
        },
        {
          "id": "M05_L03_Q04_OPT_D",
          "text": "Цвет гидроизоляционной краски."
        }
      ]
    },
    {
      "id": "M05_L03_Q05",
      "questionText": "Какой envelope drawing самый сильный для этого урока?",
      "options": [
        {
          "id": "M05_L03_Q05_OPT_A",
          "text": "Фасадная поверхность с одной подписью материала."
        },
        {
          "id": "M05_L03_Q05_OPT_B",
          "text": "Разрез стены со слоями, но без стрелок и рисков."
        },
        {
          "id": "M05_L03_Q05_OPT_C",
          "text": "Разрез стены со слоями, water path, heat flow и одной risk point."
        },
        {
          "id": "M05_L03_Q05_OPT_D",
          "text": "Moodboard внешних текстур."
        }
      ]
    }
  ]
