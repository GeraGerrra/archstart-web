  "questions": [
    {
      "id": "M07_L01_Q01",
      "questionText": "Какая главная идея resilience (устойчивости к рискам / способности восстанавливаться) в этом уроке?",
      "options": [
        {
          "id": "M07_L01_Q01_OPT_A",
          "text": "Показать драматичные изображения катастроф."
        },
        {
          "id": "M07_L01_Q01_OPT_B",
          "text": "Проектировать так, чтобы здание снижало ущерб, защищало пользователей и могло восстановиться после стресса."
        },
        {
          "id": "M07_L01_Q01_OPT_C",
          "text": "Делать каждое здание визуально тяжёлым."
        },
        {
          "id": "M07_L01_Q01_OPT_D",
          "text": "Добавлять предупреждающие знаки без пространственной стратегии."
        }
      ]
    },
    {
      "id": "M07_L01_Q02",
      "questionText": "Какая формула лучше всего описывает risk (риск) в этом уроке?",
      "options": [
        {
          "id": "M07_L01_Q02_OPT_A",
          "text": "Color + style = risk."
        },
        {
          "id": "M07_L01_Q02_OPT_B",
          "text": "Hazard + exposure + vulnerability = risk."
        },
        {
          "id": "M07_L01_Q02_OPT_C",
          "text": "Height + glass = risk always."
        },
        {
          "id": "M07_L01_Q02_OPT_D",
          "text": "Furniture + lighting = risk."
        }
      ]
    },
    {
      "id": "M07_L01_Q03",
      "questionText": "Что такое exposure (подверженность)?",
      "options": [
        {
          "id": "M07_L01_Q03_OPT_A",
          "text": "Само слабое место здания."
        },
        {
          "id": "M07_L01_Q03_OPT_B",
          "text": "Люди, элементы или функции, которые находятся в зоне опасности."
        },
        {
          "id": "M07_L01_Q03_OPT_C",
          "text": "Финальная фраза о trade-off."
        },
        {
          "id": "M07_L01_Q03_OPT_D",
          "text": "Цвет карты риска."
        }
      ]
    },
    {
      "id": "M07_L01_Q04",
      "questionText": "Какой пример лучше всего показывает redundancy (резервирование / запасной путь)?",
      "options": [
        {
          "id": "M07_L01_Q04_OPT_A",
          "text": "Только один маршрут выхода."
        },
        {
          "id": "M07_L01_Q04_OPT_B",
          "text": "Backup route, если основной маршрут заблокирован."
        },
        {
          "id": "M07_L01_Q04_OPT_C",
          "text": "Декоративный знак."
        },
        {
          "id": "M07_L01_Q04_OPT_D",
          "text": "Общая подпись “safety” без схемы."
        }
      ]
    },
    {
      "id": "M07_L01_Q05",
      "questionText": "Какое risk statement самое сильное?",
