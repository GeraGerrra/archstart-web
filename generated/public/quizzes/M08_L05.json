        {
          "id": "M08_L05_Q04_OPT_A",
          "text": "Считать его личной атакой."
        },
        {
          "id": "M08_L05_Q04_OPT_B",
          "text": "Игнорировать его."
        },
        {
          "id": "M08_L05_Q04_OPT_C",
          "text": "Использовать его, чтобы определить revision priorities и next steps."
